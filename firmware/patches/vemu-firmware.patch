index 5a1044f..ba3f62a 100644
--- a/OvmfPkg/QemuRamfbDxe/QemuRamfb.c
+++ b/OvmfPkg/QemuRamfbDxe/QemuRamfb.c
@@ -54,6 +54,22 @@ STATIC EFI_GRAPHICS_OUTPUT_MODE_INFORMATION  mQemuRamfbModeInfo[] = {
     0,    // Version
     1024, // HorizontalResolution
     768,  // VerticalResolution
+  },{
+    0,    // Version
+    1280, // HorizontalResolution
+    800,  // VerticalResolution
+  },{
+    0,    // Version
+    1366, // HorizontalResolution
+    768,  // VerticalResolution
+  },{
+    0,    // Version
+    1440, // HorizontalResolution
+    900,  // VerticalResolution
+  },{
+    0,    // Version
+    1920, // HorizontalResolution
+    1080, // VerticalResolution
   }
 };
 
@@ -314,9 +330,61 @@ InitializeQemuRamfb (
   mQemuRamfbMode.FrameBufferBase = FbBase;
 
   //
-  // 800 x 600
+  // Default mode: overridable at run time through the fw_cfg item
+  // "opt/ramfb/mode" (a decimal mode index), so QEMU can pick the boot
+  // resolution without rebuilding this firmware:
+  //   -fw_cfg name=opt/ramfb/mode,string=3
+  // Falls back to 1280x800 (mode 3) when the item is absent or invalid.
   //
-  QemuRamfbGraphicsOutputSetMode (&mQemuRamfbGraphicsOutput, 1);
+  {
+    UINTN                 DefaultMode;
+    FIRMWARE_CONFIG_ITEM  ModeItem;
+    UINTN                 ModeItemSize;
+    CHAR8                 ModeBuf[16];
+    UINTN                 Idx;
+    UINTN                 Value;
+
+    DefaultMode = 3;
+    if (!EFI_ERROR (
+          QemuFwCfgFindFile ("opt/ramfb/mode", &ModeItem, &ModeItemSize)
+          ) &&
+        (ModeItemSize > 0) && (ModeItemSize < sizeof (ModeBuf)))
+    {
+      QemuFwCfgSelectItem (ModeItem);
+      QemuFwCfgReadBytes (ModeItemSize, ModeBuf);
+      Value = 0;
+      for (Idx = 0; Idx < ModeItemSize; Idx++) {
+        if ((ModeBuf[Idx] >= '0') && (ModeBuf[Idx] <= '9')) {
+          Value = Value * 10 + (ModeBuf[Idx] - '0');
+        } else if ((ModeBuf[Idx] == '\0') ||
+                   (ModeBuf[Idx] == '\r') ||
+                   (ModeBuf[Idx] == '\n'))
+        {
+          break;
+        } else {
+          Value = (UINTN)-1;
+          break;
+        }
+      }
+
+      if (Value < ARRAY_SIZE (mQemuRamfbModeInfo)) {
+        DefaultMode = Value;
+      }
+    }
+
+    DEBUG ((
+      DEBUG_INFO,
+      "Ramfb: default mode %lu (%ux%u)\n",
+      (UINT64)DefaultMode,
+      mQemuRamfbModeInfo[DefaultMode].HorizontalResolution,
+      mQemuRamfbModeInfo[DefaultMode].VerticalResolution
+      ));
+
+    QemuRamfbGraphicsOutputSetMode (
+      &mQemuRamfbGraphicsOutput,
+      (UINT32)DefaultMode
+      );
+  }
 
   //
   // ramfb vendor devpath
