index 7c6d84d..f96f132 100644
--- a/ArmVirtPkg/Library/QemuVirtMemInfoLib/QemuVirtMemInfoLib.c
+++ b/ArmVirtPkg/Library/QemuVirtMemInfoLib/QemuVirtMemInfoLib.c
@@ -19,7 +19,7 @@
 #include <Library/FdtLib.h>
 
 // Number of Virtual Memory Map Descriptors
-#define MAX_VIRTUAL_MEMORY_MAP_DESCRIPTORS  (5)
+#define MAX_VIRTUAL_MEMORY_MAP_DESCRIPTORS  (8)
 
 /** A macro to trace the memory map.
 **/
@@ -254,6 +254,19 @@ ArmVirtGetMemoryMap (
   LOG_MEM_MAP ("System DRAM");
   Idx++;
 
+  //
+  // QEMU/mach-virt maps its core peripherals (UART, RTC, GIC, virtio-mmio
+  // and the TPM TIS window) in the miscellaneous device I/O region. Map the
+  // whole window so PEIMs such as Tcg2Pei can reach the TPM before DXE
+  // installs the GCD memory map.
+  //
+  VirtualMemoryTable[Idx].PhysicalBase = 0x08000000;
+  VirtualMemoryTable[Idx].VirtualBase  = 0x08000000;
+  VirtualMemoryTable[Idx].Length       = SIZE_128MB;
+  VirtualMemoryTable[Idx].Attributes   = ARM_MEMORY_REGION_ATTRIBUTE_DEVICE;
+  LOG_MEM_MAP ("Peripherals");
+  Idx++;
+
   // Map the FV region as normal executable memory
   VirtualMemoryTable[Idx].PhysicalBase = PcdGet64 (PcdFvBaseAddress);
   VirtualMemoryTable[Idx].VirtualBase  = VirtualMemoryTable[Idx].PhysicalBase;
