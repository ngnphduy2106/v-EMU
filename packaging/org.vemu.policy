<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>v-EMU</vendor>
  <vendor_url>https://github.com/withcoresystem/v-EMU</vendor_url>

  <action id="org.vemu.manage">
    <description>Manage v-EMU virtual machines and storage</description>
    <message>Authentication is required to manage v-EMU</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/vemud</annotate>
  </action>
</policyconfig>
